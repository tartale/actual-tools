#!/usr/bin/env bash

set -euo pipefail

THIS_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${THIS_SCRIPT_DIR}"
# shellcheck source=lib/cli-format.sh
source "${THIS_SCRIPT_DIR}/lib/cli-format.sh"

# Function to display usage and exit. Takes the exit code: 0 for an explicit --help, 1 for an error.
function usage() {
  local exitCode="${1:-1}"
  cliUsage "./actual COMMAND [ARGS]"
  echo >&2
  echo "Every command runs from the repository root, whatever directory you invoke it from." >&2
  echo >&2
  cliSection "Commands" \
    "build" "Install dependencies if needed and type-check the sources." \
    "lint" "Run eslint over the TypeScript and shellcheck over the shell scripts." \
    "test" "Run the unit test suite." \
    "budget" "Set category budgets or flag unusual spending. See './actual budget --help'." \
    "transactions" "Work with individual transactions. See './actual transactions --help'." \
    "app" "Launch the local companion app (retirement/FIRE today; more sections planned). See './actual app --help'."
  exit "${exitCode}"
}

# Function to display usage for the budget subcommand group and exit
function budgetUsage() {
  local exitCode="${1:-1}"
  cliUsage "./actual budget SUBCOMMAND [ARGS]"
  echo >&2
  cliSection "Subcommands" \
    "set-values" "Set category budgets. See './actual budget set-values --help'." \
    "anomalies" "Flag categories with unusual spending. See './actual budget anomalies --help'."
  exit "${exitCode}"
}

# Function to display usage for the transactions subcommand group and exit
function transactionsUsage() {
  local exitCode="${1:-1}"
  cliUsage "./actual transactions SUBCOMMAND [ARGS]"
  echo >&2
  cliSection "Subcommands" \
    "match-uncleared" "Tag uncleared transactions that match a cleared one."
  exit "${exitCode}"
}

# Function to install node dependencies if they are not already present
function ensureDependencies() {
  if [[ ! -d node_modules ]]; then
    echo "Installing dependencies..." >&2
    npm install
  fi
}

# Function to type-check the TypeScript sources
function commandBuild() {
  ensureDependencies
  npm run --silent typecheck
  echo "Build OK."
}

# Function to lint every language in the repo
function commandLint() {
  ensureDependencies
  npm run --silent lint

  if ! command -v shellcheck &> /dev/null; then
    echo "Warning: shellcheck not installed; skipping shell script linting." >&2
    return 0
  fi

  local shellScripts=()
  while IFS= read -r script; do
    shellScripts+=("${script}")
  done < <(git ls-files '*.sh' actual)
  shellcheck "${shellScripts[@]}"

  echo "Lint OK."
}

# Function to point Playwright at the browsers baked into the sandbox image. Playwright looks in
# ~/.cache/ms-playwright by default, but the image installs them to /ms-playwright and exports
# PLAYWRIGHT_BROWSERS_PATH from /etc/profile.d -- a *login* shell hook, so any non-login shell (an
# editor terminal, a CI step, a script) has the browsers on disk with Playwright looking elsewhere,
# failing with a bare "Executable doesn't exist at ~/.cache/...". Only fills the variable in when
# the caller hasn't set one and that directory really exists, so off the image Playwright still
# falls back to its own default location.
function ensurePlaywrightBrowsers() {
  if [[ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" && -d /ms-playwright ]]; then
    export PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
  fi
}

# Function to run the unit tests. Playwright is pointed at the image's browsers BEFORE the install
# step, not after: the playwright package's own postinstall reads PLAYWRIGHT_BROWSERS_PATH too, so
# setting it first turns a fresh `npm install` here into a no-op ("browsers are already installed")
# instead of a redundant several-hundred-megabyte download into the home cache.
function commandTest() {
  ensurePlaywrightBrowsers
  ensureDependencies
  npm run --silent test
}

# Function to dispatch the budget subcommands
function commandBudget() {
  local subcommand="${1:-}"
  if [[ -z "${subcommand}" ]]; then
    budgetUsage 1
  fi
  if [[ "${subcommand}" == "-h" || "${subcommand}" == "--help" ]]; then
    budgetUsage 0
  fi
  shift

  case "${subcommand}" in
    set-values)
      exec ./src/set-budget.ts "$@"
      ;;
    anomalies)
      exec ./src/anomalies.ts "$@"
      ;;
    *)
      echo "Unknown budget subcommand: ${subcommand}" >&2
      budgetUsage
      ;;
  esac
}

# Function to dispatch the transactions subcommands
function commandTransactions() {
  local subcommand="${1:-}"
  if [[ -z "${subcommand}" ]]; then
    transactionsUsage 1
  fi
  if [[ "${subcommand}" == "-h" || "${subcommand}" == "--help" ]]; then
    transactionsUsage 0
  fi
  shift

  case "${subcommand}" in
    match-uncleared)
      exec ./src/match-uncleared.ts "$@"
      ;;
    *)
      echo "Unknown transactions subcommand: ${subcommand}" >&2
      transactionsUsage
      ;;
  esac
}

# Function to launch the local companion app, restarting it automatically whenever a source file
# it imports changes (node's own --watch flag) -- so editing app-server.ts/fire-*.ts/etc. never
# needs a manual stop/restart; the page's own hot-reload (a per-process build id polled by the
# browser -- see app-server.ts/app.js) picks up each restart and reloads any tab left open on it.
# Skipped for -h/--help: --watch keeps node alive waiting for the next file change even after the
# script itself calls process.exit(), which would otherwise turn `./actual app --help` into a
# command that never returns.
function commandApp() {
  local arg
  for arg in "$@"; do
    if [[ "${arg}" == "-h" || "${arg}" == "--help" ]]; then
      exec ./src/app.ts "$@"
    fi
  done
  exec node --watch ./src/app.ts "$@"
}

# Main function
function main() {
  local command="${1:-}"
  if [[ -z "${command}" ]]; then
    usage
  fi
  shift

  case "${command}" in
    build) commandBuild "$@" ;;
    lint) commandLint "$@" ;;
    test) commandTest "$@" ;;
    budget) commandBudget "$@" ;;
    transactions) commandTransactions "$@" ;;
    app) commandApp "$@" ;;
    -h|--help|help) usage 0 ;;
    *)
      echo "Unknown command: ${command}" >&2
      usage
      ;;
  esac
}

# Run main function with all arguments
main "$@"

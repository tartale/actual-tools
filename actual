#!/usr/bin/env bash

set -euo pipefail

THIS_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${THIS_SCRIPT_DIR}"
# shellcheck source=lib/cli-format.sh
source "${THIS_SCRIPT_DIR}/lib/cli-format.sh"

# Four fixed ports -- one per (linked|detached) x (container|--dev) combination, so all four can run
# side by side without any of them ever landing on another by accident, matching compose.yaml's own
# published ports and src/app.ts's own default. linked keeps its original two (4276 container / 4277
# --dev, ending in this user's own 76/77 production/dev convention); detached (issue #38's standalone
# FIRE calculator, see AB_MODE) takes the next two up.
LINKED_SERVICE_PORT=4276
DETACHED_SERVICE_PORT=4277
LINKED_DEV_PORT=4278
DETACHED_DEV_PORT=4279

# Function to print the right default port for a mode+dev combination -- the one place this
# 4-way mapping is computed, so serviceStart/serviceStatus/serviceStop can't drift from each other.
function defaultPort() {
  local mode="$1" dev="$2"
  if [[ "${mode}" == "detached" ]]; then
    if [[ "${dev}" == true ]]; then echo "${DETACHED_DEV_PORT}"; else echo "${DETACHED_SERVICE_PORT}"; fi
  else
    if [[ "${dev}" == true ]]; then echo "${LINKED_DEV_PORT}"; else echo "${LINKED_SERVICE_PORT}"; fi
  fi
}

# Function to print the container name for a mode -- matches compose.yaml's own container_name for
# each service.
function containerNameForMode() {
  if [[ "$1" == "detached" ]]; then echo "actual-tools-detached"; else echo "actual-tools"; fi
}

# Function to print the compose service name for a mode -- matches compose.yaml's own service keys.
function composeServiceForMode() {
  if [[ "$1" == "detached" ]]; then echo "app-detached"; else echo "app"; fi
}

# Function to display usage and exit. Takes the exit code: 0 for an explicit --help, 1 for an error.
function usage() {
  local exitCode="${1:-1}"
  cliUsage "./actual COMMAND [ARGS]"
  echo >&2
  echo "Every command runs from the repository root, whatever directory you invoke it from." >&2
  echo >&2
  cliSection "Commands" \
    "build" "Type-check the sources, or build the container image. See './actual build --help'." \
    "lint" "Run eslint over the TypeScript and shellcheck over the shell scripts." \
    "test" "Run the unit test suite." \
    "budget" "Set category budgets or flag unusual spending. See './actual budget --help'." \
    "transactions" "Work with individual transactions. See './actual transactions --help'." \
    "service" "Run the companion app as a container. See './actual service --help'." \
    "vendor" "Check vendored third-party files against upstream. See './actual vendor --help'."
  exit "${exitCode}"
}

# Function to display usage for the budget subcommand group and exit
function budgetUsage() {
  local exitCode="${1:-1}"
  cliUsage "./actual budget SUBCOMMAND [ARGS]"
  echo >&2
  cliSection "Subcommands" \
    "set-values" "Set category budgets. See './actual budget set-values --help'." \
    "anomalies" "Flag categories with unusual spending. See './actual budget anomalies --help'."
  exit "${exitCode}"
}

# Function to display usage for the transactions subcommand group and exit
function transactionsUsage() {
  local exitCode="${1:-1}"
  cliUsage "./actual transactions SUBCOMMAND [ARGS]"
  echo >&2
  cliSection "Subcommands" \
    "match-uncleared" "Tag uncleared transactions that match a cleared one."
  exit "${exitCode}"
}

# Function to display usage for the build subcommand group and exit
function buildUsage() {
  local exitCode="${1:-1}"
  cliUsage "./actual build [SUBCOMMAND] [ARGS]"
  echo >&2
  echo "With no subcommand, type-checks the TypeScript sources." >&2
  echo >&2
  cliSection "Subcommands" \
    "image" "Build the container image the service runs (tags actual-tools:local)."
  echo >&2
  cliSection "Options (image)" \
    "-t, --tag TAG" "Tag to apply instead of actual-tools:local." \
    "--platform P" "Build for this platform instead of the host's."

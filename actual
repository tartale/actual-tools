# Function to start the app: as a container by default, or straight from the sources with --dev.
#
# --dev is the working loop, not a lesser mode of the same thing: it runs in the foreground under
# node's own --watch, so editing app-server.ts/fire-*.ts/etc. restarts the server, and the page's
# own hot-reload (a per-process build id the browser polls -- see app-server.ts/app.js) reloads any
# tab left open on it. A container would have to be rebuilt for each of those edits.
function serviceStart() {
  local dev=false
  local mode="linked"
  local port=""
  local passthrough=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dev) dev=true; shift ;;
      --mode)
        mode="${2:-}"
        if [[ "${mode}" != "linked" && "${mode}" != "detached" ]]; then
          echo "Invalid --mode \"${mode}\" -- must be \"linked\" or \"detached\"." >&2
          serviceUsage
        fi
        shift 2
        ;;
      -p | --port)
        port="${2:-}"
        if [[ -z "${port}" ]]; then
          echo "Missing argument for --port" >&2
          serviceUsage
        fi
        shift 2
        ;;
      -h | --help) serviceUsage 0 ;;
      *) passthrough+=("$1"); shift ;;
    esac
  done

  if [[ "${dev}" == true ]]; then
    # A different default per mode (see defaultPort) so up to four of these (two modes x
    # container/--dev) never collide on a port by default -- each is reachable at once, and
    # `service stop`/`stop -p` on one can't accidentally take down another.
    AB_MODE="${mode}" exec node --watch ./src/app.ts --port "${port:-$(defaultPort "${mode}" true)}" "${passthrough[@]}"
  fi
  port="${port:-$(defaultPort "${mode}" false)}"

  # Only --dev has anywhere to forward an option like --no-open to (app.ts itself, above); outside
  # --dev those were silently collected and then never used at all, so a typo'd flag looked accepted
  # and just did nothing instead of failing.
  if [[ ${#passthrough[@]} -gt 0 ]]; then
    echo "Unknown option: ${passthrough[0]}" >&2
    serviceUsage
  fi

  requireDocker
  if ! docker image inspect actual-tools:local &> /dev/null; then
    echo "No actual-tools:local image yet -- building it now (first run only)." >&2
    buildImage
  fi
  local composeService
  composeService="$(composeServiceForMode "${mode}")"
  if [[ "${mode}" == "linked" ]]; then
    # config.json is written here, so the directory has to exist before the mount does: docker
    # would otherwise create it as root and the app could not write into it. Only for the default
    # location -- an AB_DATA_DIR pointing at the daemon's host may well not be a path this side can
    # create, and silently making a local directory of that name would hide the real problem rather
    # than fix it. Detached mode has no volume at all (see compose.yaml's own doc comment on why),
    # so there's nothing to create here for it.
    if [[ -z "${AB_DATA_DIR:-}" ]]; then
      mkdir -p "${THIS_SCRIPT_DIR}/data"
    fi
    # Published port only; inside the container it is always LINKED_SERVICE_PORT (4276). See
    # compose.yaml.
    AB_PORT="${port}" docker compose up -d "${composeService}"
  else
    # Same "published port only, always 4276 inside the container" story as AB_PORT above.
    AB_DETACHED_PORT="${port}" docker compose up -d "${composeService}"
  fi
  echo
  serviceStatus --mode "${mode}" --port "${port}"
}

# Function to report whether the app is up. The port is the question that matters -- a container can
# be running with a wedged server inside it -- so that is what decides "up"; the container is then
# reported alongside as context, and only when docker is actually available.
function serviceStatus() {
  local dev=false
  local mode="linked"
  local port=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dev) dev=true; shift ;;
      --mode) mode="${2:-linked}"; shift 2 ;;
      -p | --port) port="${2:-}"; shift 2 ;;
      -h | --help) serviceUsage 0 ;;
      *) shift ;;
    esac
  done
  port="${port:-$(defaultPort "${mode}" "${dev}")}"
  # Only named in the hints below when it's not the default -- keeps the common (linked) case
  # reading exactly as it did before --mode/--dev existed.
  local modeFlag=""
  [[ "${mode}" == "detached" ]] && modeFlag=" --mode detached"
  local devFlag=""
  [[ "${dev}" == true ]] && devFlag=" --dev"

  if portListening "${port}"; then
    echo "● up      http://localhost:${port}/"
  else
    echo "○ down    nothing is listening on port ${port}"
  fi

  # --dev is a plain node process, never a container -- nothing to report here.
  if [[ "${dev}" != true ]] && command -v docker &> /dev/null && docker info &> /dev/null; then
    local containerName container
    containerName="$(containerNameForMode "${mode}")"
    container="$(docker ps -a --filter "name=^${containerName}$" --format '{{.Status}}' 2> /dev/null || true)"
    if [[ -n "${container}" ]]; then
      echo "          container: ${container}"
    else
      echo "          container: not created"
    fi
  fi

  if portListening "${port}"; then
    echo "          Stop with: ./actual service stop${modeFlag}${devFlag}"
  else
    echo "          Start with: ./actual service start${modeFlag}${devFlag}"
  fi
}

# Function to stop the app, whichever way it was started. Both are attempted rather than one being
# inferred: a --dev run and a container can each be holding the port, and stopping only the kind
# that was asked about leaves the other one running and the port still taken. Scoped to the one
# compose SERVICE for this mode (docker compose rm -sf, not `down`) -- `down` tears down the whole
# project, including the network the other mode's own service shares and depends on still being up.
function serviceStop() {
  local dev=false
  local mode="linked"
  local port=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dev) dev=true; shift ;;
      --mode) mode="${2:-linked}"; shift 2 ;;
      -p | --port) port="${2:-}"; shift 2 ;;
      -h | --help) serviceUsage 0 ;;
      *) shift ;;
    esac
  done
  port="${port:-$(defaultPort "${mode}" "${dev}")}"

  local stopped=false
  # --dev never touches docker at all (it's a plain node process, not a container) -- the container
  # for this same mode may well be running at the same time on its own port, and must be left alone.
  if [[ "${dev}" != true ]] && command -v docker &> /dev/null && docker info &> /dev/null; then
    local containerName composeService
    containerName="$(containerNameForMode "${mode}")"
    composeService="$(composeServiceForMode "${mode}")"
    if [[ -n "$(docker ps -a --filter "name=^${containerName}$" --format '{{.ID}}' 2> /dev/null || true)" ]]; then
      docker compose rm -sf "${composeService}"
      stopped=true
    fi
  fi

  if portListening "${port}"; then
    local pids
    pids="$(pidsOnPort "${port}")"
    if [[ -n "${pids}" ]]; then
      echo "Stopping the process on port ${port} (PIDs: $(echo "${pids}" | tr '\n' ' '))" >&2
      # shellcheck disable=SC2086
      kill ${pids} 2> /dev/null || true
      local waited=0
      while [[ ${waited} -lt 10 ]] && portListening "${port}"; do
        sleep 1
        waited=$((waited + 1))
      done
      if portListening "${port}"; then
        echo "Still up after ${waited}s; forcing." >&2
        # shellcheck disable=SC2086
        kill -9 ${pids} 2> /dev/null || true
      fi
      stopped=true
    else
      echo "Something is listening on port ${port} but its process could not be identified." >&2
    fi
  fi

  if [[ "${stopped}" == true ]]; then
    echo "Stopped."
  else
    echo "Nothing to stop."
  fi
}

# Main function
function main() {
  local command="${1:-}"
  if [[ -z "${command}" ]]; then
    usage
  fi
  shift

  case "${command}" in
    build) commandBuild "$@" ;;
    lint) commandLint "$@" ;;
    test) commandTest "$@" ;;
    budget) commandBudget "$@" ;;
    transactions) commandTransactions "$@" ;;
    service) commandService "$@" ;;
    vendor) commandVendor "$@" ;;
    -h|--help|help) usage 0 ;;
    *)
      echo "Unknown command: ${command}" >&2
      usage
      ;;
  esac
}

# Run main function with all arguments
main "$@"

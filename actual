# Function to display usage for the service subcommand group and exit
function serviceUsage() {
  local exitCode="${1:-1}"
  cliUsage "./actual service SUBCOMMAND [ARGS]"
  echo >&2
  cliSection "Subcommands" \
    "start" "Start the app in a container (docker compose up -d)." \
    "status" "Report whether the app is up, and where to reach it." \
    "stop" "Stop the app, container or --dev process alike."
  echo >&2
  cliSection "Options" \
    "--dev" "start: run the sources directly instead, in the foreground, restarting on every edit. The container is not involved." \
    "--mode linked|detached" "Which deployment to act on (default: linked -- today's app). detached is issue #38's standalone FIRE calculator, no connection of any kind." \
    "-p, --port N" "Port to check or serve on (default: ${LINKED_SERVICE_PORT} linked / ${DETACHED_SERVICE_PORT} detached, or ${LINKED_DEV_PORT} / ${DETACHED_DEV_PORT} with --dev)."
  exit "${exitCode}"
}

# Function to display usage for the vendor subcommand group and exit
function vendorUsage() {
  local exitCode="${1:-1}"
  cliUsage "./actual vendor SUBCOMMAND [ARGS]"
  echo >&2
  cliSection "Subcommands" \
    "check" "Check vendored third-party files against upstream (git blob hash, no content diff)."
  exit "${exitCode}"
}

# Function to fail with a clear message unless docker is installed and its daemon is reachable --
# every message it can produce is more useful than the daemon's own connection error.
function requireDocker() {
  if ! command -v docker &> /dev/null; then
    echo "docker not found; it is required to build or run the service." >&2
    echo "Run './actual service start --dev' to run from the sources instead." >&2
    exit 1
  fi
  if ! docker info &> /dev/null; then
    echo "The docker daemon isn't reachable; start Docker and try again." >&2
    exit 1
  fi
}

# Function to report whether anything is actually accepting connections on a port. A connect is the
# only thing that settles this: matching process names also matches the command asking the question,
# which reports a server as up when nothing is listening. bash's own /dev/tcp keeps it dependency
# free -- neither lsof nor ss is present in every image this runs in.
function portListening() {
  local port="$1"
  (exec 3<> "/dev/tcp/127.0.0.1/${port}") &> /dev/null
}

# Function to list the PIDs listening on a port, for stopping a --dev run. Prefers fuser, falls back
# to matching the app's own command line with this process tree excluded, so the pipeline asking the
# question can never match itself.
function pidsOnPort() {
  local port="$1"
  if command -v fuser &> /dev/null; then
    fuser "${port}/tcp" 2> /dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' || true
    return 0
  fi
  pgrep -f "app\.ts" 2> /dev/null | grep -v -e "^$$\$" -e "^$PPID\$" || true
}

# Function to install node dependencies if they are not already present
function ensureDependencies() {
  if [[ ! -d node_modules ]]; then
    echo "Installing dependencies..." >&2
    npm install
  fi
}

# Function to type-check the TypeScript sources, or build the container image
function commandBuild() {
  local subcommand="${1:-}"
  if [[ "${subcommand}" == "-h" || "${subcommand}" == "--help" ]]; then
    buildUsage 0
  fi
  if [[ "${subcommand}" == "image" ]]; then
    shift
    buildImage "$@"
    return 0
  fi
  if [[ -n "${subcommand}" ]]; then
    echo "Unknown build subcommand: ${subcommand}" >&2
    buildUsage
  fi

  ensureDependencies
  npm run --silent typecheck
  echo "Build OK."
}

# Function to build the container image the service runs. Tagged locally and never pushed: compose
# refers to that same local tag deliberately, so there is no registry in the loop to serve up an
# older image than the checkout being run.
function buildImage() {
  requireDocker

  local tag="actual-tools:local"
  local platformArgs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t | --tag)
        tag="${2:-}"
        if [[ -z "${tag}" ]]; then
          echo "Missing argument for --tag" >&2
          buildUsage
        fi
        shift 2
        ;;
      --platform)
        if [[ -z "${2:-}" ]]; then
          echo "Missing argument for --platform" >&2
          buildUsage
        fi
        platformArgs=(--platform "$2")
        shift 2
        ;;
      -h | --help) buildUsage 0 ;;
      *)
        echo "Unknown option: $1" >&2
        buildUsage
        ;;
    esac
  done

  echo "Building ${tag}..." >&2
  docker build "${platformArgs[@]}" -t "${tag}" .
  echo "Built ${tag}."
}

# Function to lint every language in the repo
function commandLint() {
  ensureDependencies
  npm run --silent lint

  if ! command -v shellcheck &> /dev/null; then
    echo "Warning: shellcheck not installed; skipping shell script linting." >&2
    return 0
  fi

  local shellScripts=()
  while IFS= read -r script; do
    shellScripts+=("${script}")
  done < <(git ls-files '*.sh' actual)
  shellcheck "${shellScripts[@]}"

  echo "Lint OK."
}

# Function to point Playwright at the browsers baked into the sandbox image. Playwright looks in
# ~/.cache/ms-playwright by default, but the image installs them to /ms-playwright and exports
# PLAYWRIGHT_BROWSERS_PATH from /etc/profile.d -- a *login* shell hook, so any non-login shell (an
# editor terminal, a CI step, a script) has the browsers on disk with Playwright looking elsewhere,
# failing with a bare "Executable doesn't exist at ~/.cache/...". Only fills the variable in when
# the caller hasn't set one and that directory really exists, so off the image Playwright still
# falls back to its own default location.
function ensurePlaywrightBrowsers() {
  if [[ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" && -d /ms-playwright ]]; then
    export PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
  fi
}

# Function to run the unit tests. Playwright is pointed at the image's browsers BEFORE the install
# step, not after: the playwright package's own postinstall reads PLAYWRIGHT_BROWSERS_PATH too, so
# setting it first turns a fresh `npm install` here into a no-op ("browsers are already installed")
# instead of a redundant several-hundred-megabyte download into the home cache.
function commandTest() {
  ensurePlaywrightBrowsers
  ensureDependencies
  npm run --silent test
}

# Function to dispatch the budget subcommands
function commandBudget() {
  local subcommand="${1:-}"
  if [[ -z "${subcommand}" ]]; then
    budgetUsage 1
  fi
  if [[ "${subcommand}" == "-h" || "${subcommand}" == "--help" ]]; then
    budgetUsage 0
  fi
  shift

  case "${subcommand}" in
    set-values)
      exec ./src/set-budget.ts "$@"
      ;;
    anomalies)
      exec ./src/anomalies.ts "$@"
      ;;
    *)
      echo "Unknown budget subcommand: ${subcommand}" >&2
      budgetUsage
      ;;
  esac
}


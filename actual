    transactionsUsage 1
  fi
  if [[ "${subcommand}" == "-h" || "${subcommand}" == "--help" ]]; then
    transactionsUsage 0
  fi
  shift

  case "${subcommand}" in
    match-uncleared)
      exec ./src/match-uncleared.ts "$@"
      ;;
    *)

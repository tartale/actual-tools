}

# Function to dispatch the service subcommands
function commandService() {
  local subcommand="${1:-}"
  if [[ -z "${subcommand}" ]]; then
    serviceUsage 1
  fi
  if [[ "${subcommand}" == "-h" || "${subcommand}" == "--help" ]]; then
    serviceUsage 0
  fi
  shift

  case "${subcommand}" in
    start) serviceStart "$@" ;;
    status) serviceStatus "$@" ;;
    stop) serviceStop "$@" ;;
    *)
      echo "Unknown service subcommand: ${subcommand}" >&2
      serviceUsage
      ;;
  esac
}

